<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Botella VACIA (vidrio), 4.5x4.5x13.6 cm, cuello 3 cm para la garra del R3
       Objeto ANIMADO: lo posiciona el coordinador con el servicio set_pose de Gazebo.
       Sin gravedad ni colisiones, asi la fisica no lo empuja mientras los robots lo "llevan". -->
  <model name="botella">
    <link name="link">
      <gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="vis">
        <geometry><mesh><uri>model://botella/meshes/botella.stl</uri></mesh></geometry>
        <material>
          <ambient>0.70 0.85 0.75 1</ambient>
          <diffuse>0.70 0.85 0.75 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
        <transparency>0.45</transparency>
      </visual>
    </link>
  </model>
</sdf>
