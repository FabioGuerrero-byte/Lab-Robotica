<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Botella LLENA de aceite (aparece al llenarse en PLL)
       Objeto ANIMADO: lo posiciona el coordinador con el servicio set_pose de Gazebo.
       Sin gravedad ni colisiones, asi la fisica no lo empuja mientras los robots lo "llevan". -->
  <model name="botella_llena">
    <link name="link">
      <gravity>false</gravity>
      <inertial><mass>0.05</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="vis">
        <geometry><mesh><uri>model://botella_llena/meshes/botella.stl</uri></mesh></geometry>
        <material>
          <ambient>0.45 0.55 0.05 1</ambient>
          <diffuse>0.45 0.55 0.05 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
        <transparency>0.05</transparency>
      </visual>
    </link>
  </model>
</sdf>
